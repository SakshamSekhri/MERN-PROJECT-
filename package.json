{
  "name": "pixelverse",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "dev:lan": "node scripts/dev-local.mjs --lan",
    "dev:web": "node scripts/dev-web.mjs",
    "dev:api": "node --watch backend/index.js",
    "build": "vite build",
    "test": "node --test --test-concurrency=1 tests/*.test.js tests/*.test.mjs",
    "start:api": "node backend/index.js",
    "seed:gallery": "node scripts/seed-gallery-examples.js",
    "moderator": "node scripts/set-moderator.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.2.0",
    "jose": "^6.2.12",
    "mongoose": "^8.9.0",
    "nodemailer": "^10.1.0",
    "vite": "^6.0.0"
  }
}
